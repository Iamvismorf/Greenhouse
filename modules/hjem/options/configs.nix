{
  modules.hjem.options = {lib, ...}: let
    functor = lib.types.functionTo (lib.types.functionTo lib.types.path);
    directory = lib.types.attrsOf (lib.types.oneOf [directory functor lib.types.path]);
  in {
    options.hjem.metadata = lib.mkOption {
      type = lib.types.attrsOf directory;
      default = {};
      example = lib.literalExpression ''
        hjem.metadata.<username> = {
            # attributes should be generated by utils.directoryToAttrs
            foo = {
               __functor: self: args: /path/to/foo;
               barIni = /path/to/bar.ini;
               nested = {
                  __functor: self: args: /path/to/nested;
                  fooConf = /path/to/foo.conf;
               };
            };
        };
      '';
    };
  };
}
